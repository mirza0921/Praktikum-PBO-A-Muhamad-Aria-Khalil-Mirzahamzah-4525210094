@startuml perpustakaan-class
title Sistem Perpustakaan — Class Diagram (Sesi 7)

skinparam classAttributeIconSize 0
skinparam shadowing false

' ─────────────────────────────────────────────────────────────
' KERANGKA. Lengkapi setiap bagian bertanda TODO.
' Setiap kelas di sini harus ada di kode Anda, dan sebaliknya.
' ─────────────────────────────────────────────────────────────

package model {

  abstract class Koleksi {
    - nomorInduk : String
    - judul : String
    - penulis : String
    - tahun : int
    - jumlahEksemplar : int
    - status : StatusKoleksi
    + {abstract} masaPinjamHari() : int
    + {abstract} bolehDipinjam() : boolean
    + tersedia() : boolean
  }

  ' TODO 1: tambahkan tiga turunan Koleksi — Buku, Majalah, Skripsi.
  '         Perhatikan masa pinjam masing-masing.
  '
  ' Keputusan: Buku dipinjam 14 hari, Majalah 7 hari,
  ' Skripsi hanya baca di tempat (masa pinjam 0, tidak boleh dipinjam).
  ' Angka ini perlu dicocokkan dengan deskripsi-kebutuhan.md.
  Koleksi <|-- Buku
  Koleksi <|-- Majalah
  Koleksi <|-- Skripsi

  class Buku {
    - isbn : String
    - penerbit : String
    + masaPinjamHari() : int
    + bolehDipinjam() : boolean
  }

  class Majalah {
    - edisi : String
    + masaPinjamHari() : int
    + bolehDipinjam() : boolean
  }

  class Skripsi {
    - pembimbing : String
    + masaPinjamHari() : int
    + bolehDipinjam() : boolean
  }

  class Bab {
    - nomor : int
    - judul : String
  }

  ' TODO 2: tambahkan kelas Anggota dan Peminjaman beserta atributnya.
  class Anggota {
    - nomorAnggota : String
    - nama : String
    - jenis : JenisKeanggotaan
  }

  class Peminjaman {
    - tanggalPinjam : LocalDate
    - jatuhTempo : LocalDate
    ' tanggalKembali bernilai null selama buku belum dikembalikan
    - tanggalKembali : LocalDate
    + aktif() : boolean
  }

  ' TODO 3: tambahkan enum StatusKoleksi dan enum/kelas JenisKeanggotaan.
  enum StatusKoleksi {
    TERSEDIA
    DIPINJAM
    HABIS
  }

  enum JenisKeanggotaan {
    MAHASISWA
    DOSEN
    UMUM
  }

  ' ── RELASI ───────────────────────────────────────────────
  ' TODO 4: lengkapi relasi berikut. Untuk setiap relasi, tentukan
  '         derajat keterikatannya DAN tulis multiplicity di kedua ujung.
  '
  '   Notasi:  *--  komposisi   o--  agregasi   -->  asosiasi   ..>  dependensi
  '
  ' Buku ? Bab                 -> pikirkan: bab bisa hidup tanpa buku?
  ' Anggota ? Peminjaman       -> pikirkan: peminjaman bisa hidup tanpa anggota?
  ' Peminjaman ? Koleksi       -> pikirkan: koleksi bisa hidup tanpa peminjaman?
  '
  ' Jawaban:
  ' - Buku *-- Bab: komposisi. Bab tidak punya arti tanpa buku induknya.
  ' - Anggota *-- Peminjaman: komposisi. Riwayat pinjam dimiliki anggota.
  ' - Peminjaman --> Koleksi: asosiasi. Koleksi tidak memiliki peminjaman
  '   (koleksi tetap ada walau tidak pernah dipinjam), dan peminjaman
  '   bukan bagian dari koleksi.
  Buku "1" *-- "0..*" Bab : terdiri dari >
  Anggota "1" *-- "0..*" Peminjaman : memiliki riwayat >
  Peminjaman "0..*" --> "1" Koleksi : mencatat >

  ' TODO 5: relasi ini SALAH. Perbaiki.
  ' Sudah diperbaiki: Bab bukan turunan Koleksi, melainkan bagian dari Buku
  ' (lihat relasi Buku *-- Bab di TODO 4). Relasi Koleksi <|-- Bab dihapus.

}

package service {
  class PerpustakaanService {
    + tambahKoleksi(k : Koleksi) : void
    + daftarkanAnggota(a : Anggota) : void
    + pinjam(nomorAnggota : String, nomorInduk : String) : Peminjaman
    + kembalikan(nomorAnggota : String, nomorInduk : String) : void
    + cariKoleksi(nomorInduk : String) : Koleksi
  }

  ' TODO 6: tambahkan relasi antara PerpustakaanService dengan Koleksi
  '         dan Anggota. Agregasi atau komposisi? Beri alasannya di analisis.md.
  '
  ' Keputusan: agregasi. Layanan hanya menyimpan referensi ke koleksi dan
  ' anggota yang dibuat di luar. Koleksi dan anggota tetap ada meski
  ' layanan dihentikan. Sejalan dengan keputusan agregasi di PerpustakaanService.java.
  PerpustakaanService "1" o-- "0..*" Koleksi : menyimpan >
  PerpustakaanService "1" o-- "0..*" Anggota : menyimpan >
  PerpustakaanService ..> Peminjaman : membuat >
}

@enduml


